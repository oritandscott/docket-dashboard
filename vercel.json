{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)data/'",
  "crons": [
    {
      "path": "/api/generate-post",
      "schedule": "0 14 */3 * *"
    },
    {
      "path": "/api/machine-status?job=digest",
      "schedule": "35 14 * * *"
    }
  ]
}
